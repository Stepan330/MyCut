<UserControl x:Class="MyCut.Editor.Controls.ParameterRow" x:Name="Root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:motion="clr-namespace:MyCut.Editor.Motion" ToolTip="{Binding Label, ElementName=Root}">
 <Grid Height="26" Margin="0,0,0,2">
  <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding LabelWidth, ElementName=Root}"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
  <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="11.5" Margin="0,0,6,0" TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
   <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding ShortLabel, ElementName=Root}"/>
    <Style.Triggers><DataTrigger Binding="{Binding ShortLabel, ElementName=Root}" Value="{x:Null}"><Setter Property="Text" Value="{Binding Label, ElementName=Root}"/></DataTrigger></Style.Triggers>
   </Style></TextBlock.Style>
  </TextBlock>
  <Border x:Name="ValueSurface" Grid.Column="1" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource CanvasBrush}" Cursor="SizeWE"
   ToolTip="Drag to change · click to type · Shift: fine · Ctrl: fast · Esc: cancel"
   PreviewMouseLeftButtonDown="OnPointerDown" PreviewMouseMove="OnPointerMove" PreviewMouseLeftButtonUp="OnPointerUp" LostMouseCapture="OnLostCapture"
   MouseEnter="OnHover" MouseLeave="OnHover" motion:MotionBehavior.Enabled="True" AutomationProperties.Name="{Binding Label, ElementName=Root}">
   <Grid ClipToBounds="True">
    <Border Background="{DynamicResource AccentSurfaceBrush}" Opacity="0.3" IsHitTestVisible="False" Height="2" VerticalAlignment="Bottom" RenderTransformOrigin="0,0">
     <Border.RenderTransform><ScaleTransform x:Name="FillScale" ScaleX="0"/></Border.RenderTransform>
    </Border>
    <TextBlock x:Name="ValueDisplay" HorizontalAlignment="Right" FontFamily="{DynamicResource MonoFont}" FontSize="12" Margin="3,0,18,0" IsHitTestVisible="False"/>
    <TextBlock x:Name="DragHint" Text="↔" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,0,4,0" IsHitTestVisible="False"/>
    <TextBox x:Name="ValueEditor" Visibility="Collapsed" HorizontalAlignment="Stretch" MinHeight="0" Margin="1" FontSize="12" TextAlignment="Right" BorderThickness="0" Padding="3,0" Cursor="IBeam"
     LostKeyboardFocus="OnEditorLostFocus" PreviewKeyDown="OnEditorKeyDown"/>
   </Grid>
  </Border>
 </Grid>
</UserControl>
