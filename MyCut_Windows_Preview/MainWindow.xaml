<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="MyCut - Review Preview 0.1" Width="1400" Height="900" MinWidth="1000" MinHeight="720"
 WindowStartupLocation="CenterScreen" Background="#141820" Foreground="#E6ECF5" FontFamily="Segoe UI" FontSize="13" AllowDrop="True">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#29313E"/><Setter Property="Foreground" Value="#E6ECF5"/>
   <Setter Property="BorderBrush" Value="#3B4656"/><Setter Property="Padding" Value="12,7"/>
   <Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5">
     <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.8"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#12161D"/><Setter Property="Foreground" Value="#E6ECF5"/><Setter Property="BorderBrush" Value="#3B4656"/><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="3"/><Setter Property="CaretBrush" Value="#E6ECF5"/></Style>
  <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E6ECF5"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8,0"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#1A202A"/><Setter Property="Foreground" Value="#E6ECF5"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style x:Key="CardStyle" TargetType="ListBoxItem">
   <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="5"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Card" CornerRadius="7" Background="#242D3A" BorderBrush="#3A4657" BorderThickness="1" Padding="9" RenderTransformOrigin="0.5,0.5">
     <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
     <ContentPresenter/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#79B6FF"/><Setter TargetName="Card" Property="Background" Value="#253A54"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True">
      <Trigger.EnterActions><BeginStoryboard><Storyboard>
       <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.025" Duration="0:0:0.12"/>
       <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.025" Duration="0:0:0.12"/>
      </Storyboard></BeginStoryboard></Trigger.EnterActions>
      <Trigger.ExitActions><BeginStoryboard><Storyboard>
       <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12"/>
       <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12"/>
      </Storyboard></BeginStoryboard></Trigger.ExitActions>
     </Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="6"/><RowDefinition Height="215"/><RowDefinition Height="32"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#1B222D" Padding="14,7">
   <DockPanel>
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
     <Button x:Name="OpenCollection" Content="Open collection"/>
     <Button x:Name="SaveCollection" Content="Save collection"/>
     <Button x:Name="ImportButton" Content="+ Import files" Background="#286FBA"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal"><TextBlock Text="MyCut" FontSize="22" FontWeight="SemiBold" Margin="0,0,14,0"/><TextBlock Text="Review Preview 0.1" Foreground="#A3B0C3"/></StackPanel>
   </DockPanel>
  </Border>
  <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,0">
   <Button Content="Review" Background="#253A54"/>
   <Button Content="Edit" IsEnabled="False"/><Button Content="Animate" IsEnabled="False"/><Button Content="Item Editor" IsEnabled="False"/>
   <Button Content="VFX" IsEnabled="False"/><Button Content="Audio" IsEnabled="False"/><Button Content="Color" IsEnabled="False"/><Button Content="Export" IsEnabled="False"/>
  </StackPanel>
  <Grid Grid.Row="2" Margin="10,5">
   <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="255"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#1B222D" CornerRadius="7" Padding="10">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top"><TextBlock Text="MEDIA LIBRARY" Foreground="#A3B0C3" Margin="5,6,0,12"/></StackPanel>
     <ListBox x:Name="CategoryList" SelectedIndex="0">
      <ListBoxItem Content="All materials" Tag="All" Padding="7"/>
      <ListBoxItem Content="Video" Tag="Video" Padding="7"/><ListBoxItem Content="Photos" Tag="Photo" Padding="7"/>
      <ListBoxItem Content="Audio" Tag="Audio" Padding="7"/><ListBoxItem Content="Favorites" Tag="Favorite" Padding="7"/>
      <ListBoxItem Content="With ranges" Tag="Ranges" Padding="7"/>
     </ListBox>
    </DockPanel>
   </Border>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#303A48"/>
   <Grid Grid.Column="2" Margin="9,0">
    <Grid.RowDefinitions><RowDefinition Height="37"/><RowDefinition Height="*"/><RowDefinition Height="44"/><RowDefinition x:Name="SourceRow" Height="175"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0">
     <Button x:Name="FavoriteButton" Content="Favorite" DockPanel.Dock="Right"/>
     <TextBlock x:Name="SourceTitle" Text="Choose a material" FontSize="16" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
    <Border Grid.Row="1" Background="#070B11" CornerRadius="7" ClipToBounds="True">
     <Grid x:Name="ViewerGrid">
      <MediaElement x:Name="Media" LoadedBehavior="Manual" UnloadedBehavior="Close" ScrubbingEnabled="True" Stretch="Uniform"/>
      <Image x:Name="Photo" Stretch="Uniform" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><ScaleTransform x:Name="PhotoTransform"/></Image.RenderTransform></Image>
      <StackPanel x:Name="EmptyView" HorizontalAlignment="Center" VerticalAlignment="Center">
       <TextBlock x:Name="EmptyTitle" Text="Drop files here or click Import" FontSize="21" HorizontalAlignment="Center"/>
       <TextBlock x:Name="EmptyDetail" Text="Video, photos and audio" Foreground="#A3B0C3" Margin="0,10" HorizontalAlignment="Center" TextWrapping="Wrap"/>
      </StackPanel>
      <Border Background="#CE162333" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10" Padding="8,4" CornerRadius="4"><TextBlock x:Name="ViewerBadge" Text="Local source viewer" FontSize="11"/></Border>
     </Grid>
    </Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="BackFrame" Content="- frame"/><Button x:Name="PlayButton" Content="Play" Background="#253A54"/><Button x:Name="NextFrame" Content="+ frame"/>
     <TextBox x:Name="TimeInput" Text="00:00:00.000" Width="118" VerticalContentAlignment="Center" ToolTip="Enter a time, then press Enter"/>
     <TextBlock x:Name="DurationLabel" Text="/ 00:00:00.000" FontSize="11" Foreground="#A3B0C3" Margin="5"/>
     <CheckBox x:Name="MuteCheck" Content="Mute"/>
     <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" Value="0.7" Width="60" VerticalAlignment="Center" ToolTip="Volume"/>
    </StackPanel>
    <Border Grid.Row="3" x:Name="SourcePanel" Background="#1B222D" CornerRadius="6" Padding="9" Margin="0,4,0,0">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="31"/><RowDefinition Height="60"/><RowDefinition Height="24"/><RowDefinition Height="35"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0">
       <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="FitSource" Content="Fit source" Padding="7,3"/><Button x:Name="FitRange" Content="Fit range" Padding="7,3"/><Slider x:Name="ZoomSlider" Minimum="1" Maximum="8" Value="1" Width="75" VerticalAlignment="Center"/></StackPanel>
       <TextBlock Text="SOURCE TIME" Foreground="#A3B0C3" FontSize="11"/>
      </DockPanel>
      <Canvas Grid.Row="1" x:Name="TimelineCanvas" Background="#252F3E" ClipToBounds="True"/>
      <Slider Grid.Row="2" x:Name="SeekSlider" Minimum="0" Maximum="1" Value="0" IsMoveToPointEnabled="True"/>
      <StackPanel Grid.Row="3" Orientation="Horizontal">
       <Button x:Name="MarkIn" Content="Mark In  [I]" Padding="8,4"/><Button x:Name="MarkOut" Content="Mark Out  [O]" Padding="8,4"/>
       <Button x:Name="AddMarker" Content="Marker  [M]" Padding="8,4"/><CheckBox x:Name="LoopCheck" Content="Loop range"/>
       <TextBlock x:Name="RangeInfo" Foreground="#A3B0C3" FontSize="11" Margin="8,0"/>
      </StackPanel>
     </Grid>
    </Border>
   </Grid>
   <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#303A48"/>
   <Border Grid.Column="4" Background="#1B222D" CornerRadius="7" Padding="12">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <TextBlock Text="SOURCE DETAILS" Foreground="#A3B0C3" Margin="0,2,0,12"/>
      <TextBlock x:Name="SourceDetails" Text="No source selected" TextWrapping="Wrap"/>
      <Button x:Name="RelinkButton" Content="Locate source" Margin="0,10" HorizontalAlignment="Left"/>
      <TextBlock Text="Source note" Foreground="#A3B0C3" Margin="0,9,0,3"/>
      <TextBox x:Name="NoteInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="55"/>
      <TextBlock Text="PHOTO VIEW" Foreground="#A3B0C3" Margin="0,14,0,4"/>
      <Slider x:Name="PhotoZoom" Minimum="1" Maximum="4" Value="1" IsEnabled="False"/>
      <TextBlock Text="SELECTED RANGES" Foreground="#A3B0C3" Margin="0,18,0,7"/>
      <TextBox x:Name="RangeName" Text="" ToolTip="Name the selected range"/>
      <Button x:Name="SaveRange" Content="Save range" Background="#286FBA"/>
      <ListBox x:Name="RangeList" Margin="0,8" MinHeight="70" MaxHeight="160" DisplayMemberPath="Label"/>
      <Button x:Name="DeleteRange" Content="Remove range" HorizontalAlignment="Left"/>
      <TextBlock Text="Markers" Foreground="#A3B0C3" Margin="0,15,0,5"/>
      <ListBox x:Name="MarkerList" MaxHeight="110" DisplayMemberPath="Label"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
  <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="#303A48"/>
  <Border Grid.Row="4" Margin="10,5" Background="#1B222D" CornerRadius="7" Padding="8">
   <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,7">
     <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><CheckBox x:Name="HoverCheck" Content="Hover preview" IsChecked="True"/><Button x:Name="ViewMode" Content="List view"/></StackPanel>
     <StackPanel Orientation="Horizontal"><TextBlock Text="MATERIALS" Foreground="#A3B0C3" Margin="7"/><TextBox x:Name="SearchInput" Width="210" ToolTip="Search file names"/></StackPanel>
    </DockPanel>
    <ListBox x:Name="MediaList" ItemContainerStyle="{StaticResource CardStyle}" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
     <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
     <ListBox.ItemTemplate><DataTemplate>
      <StackPanel Width="160">
       <Grid Height="62" Background="#101822">
        <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
        <TextBlock Text="{Binding Kind}" HorizontalAlignment="Center" Foreground="#AABCD1"/>
       </Grid>
       <TextBlock Text="{Binding Name}" Margin="0,7,0,2" TextTrimming="CharacterEllipsis"/>
       <TextBlock Text="{Binding Summary}" Foreground="#A3B0C3" FontSize="11"/>
      </StackPanel>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
  </Border>
  <Border Grid.Row="5" Background="#1B222D" Padding="14,4"><DockPanel><TextBlock Text="Space: Play/Pause   I/O: Range   M: Marker" DockPanel.Dock="Right" FontSize="11" Foreground="#A3B0C3"/><TextBlock x:Name="StatusText" Text="Ready" FontSize="11" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
  <Popup x:Name="HoverPopup" Placement="MousePoint" HorizontalOffset="18" VerticalOffset="18" StaysOpen="True" AllowsTransparency="True" IsHitTestVisible="False">
   <Border Background="#111824" BorderBrush="#79B6FF" BorderThickness="1" CornerRadius="6" Padding="8"><StackPanel>
    <MediaElement x:Name="HoverMedia" Width="300" Height="170" LoadedBehavior="Manual" UnloadedBehavior="Close" IsMuted="True" Stretch="Uniform"/>
    <TextBlock x:Name="HoverTitle" Foreground="#E6ECF5" Margin="2,7,2,0"/>
   </StackPanel></Border>
  </Popup>
 </Grid>
</Window>
